{
  "name": "@helsevestikt/hviktor-angular",
  "version": "0.3.4",
  "description": "Angular-komponenter basert på Digdir Designsystemet for Helse Vest IKT",
  "keywords": [
    "angular",
    "components",
    "designsystemet",
    "digdir",
    "helse-vest",
    "a11y",
    "wcag",
    "ui"
  ],
  "author": {
    "name": "Helse Vest IKT"
  },
  "bugs": {
    "url": "https://github.com/HelseVestIKT/hviktor/issues"
  },
  "homepage": "https://helsevestikt.github.io/hviktor",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HelseVestIKT/hviktor",
    "directory": "projects/hviktor"
  },
  "scripts": {
    "build": "tsc -p tsconfig.schematics.json",
    "postbuild": "npx copyfiles schematics/*/schema.json schematics/*/files/** schematics/collection.json schematics/package.json ../../dist/hviktor-lib && node -e \"require('fs').writeFileSync('../../dist/hviktor-lib/.npmignore','')\""
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0 <23.0.0",
    "@angular/core": ">=17.0.0 <23.0.0"
  },
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "dependencies"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "~1.21.0",
    "@digdir/designsystemet-types": "~1.21.0",
    "@digdir/designsystemet-web": "~1.21.0",
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@tanstack/angular-table": "^8.21.4",
    "@u-elements/u-combobox": "^2.0.4",
    "@u-elements/u-details": "^1.0.0",
    "@u-elements/u-tabs": "^1.0.3",
    "tslib": "^2.3.0"
  },
  "exports": {
    "./styles.css": "./styles.css",
    "./theme.css": "./design-tokens-build/hvikt.css",
    "./theme-types": "./design-tokens-build/types.d.ts"
  },
  "files": [
    "fesm2022/",
    "schematics/",
    "types/",
    "design-tokens-build/",
    "index.d.ts",
    "styles.css",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
